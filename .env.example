# ---------------------------------------------------------------------------
# ForgeSRE configuration. Copy to .env (scripts/setup.sh does this for you and
# generates random database passwords).
# ---------------------------------------------------------------------------

# Demo production stack (docker compose)
POSTGRES_PASSWORD=change-me
MONITOR_PASSWORD=change-me-too
PG_MAX_CONNECTIONS=100
PAYMENT_V1_POOL_MAX=10
PAYMENT_V2_POOL_MAX=85
# Alternate latency-regression scenario; values are configurable and scoped to payment-service v3.
PAYMENT_V3_HOST_PORT=18103
PAYMENT_V3_PROCESSOR_LATENCY_MIN_MS=1200
PAYMENT_V3_PROCESSOR_LATENCY_MAX_MS=1500
TRAFFIC_RPS=10

# Host ports (all bound to 127.0.0.1)
GATEWAY_HOST_PORT=18080
PAYMENT_V1_HOST_PORT=18101
PAYMENT_V2_HOST_PORT=18102
PROMETHEUS_HOST_PORT=19090
PG_HOST_PORT=15432

# ForgeSRE MCP server (streamable HTTP, consumed by TrueForge)
FORGESRE_MCP_HOST=127.0.0.1
FORGESRE_MCP_PORT=18900
# Optional TrueForge endpoint. Leave blank for loopback local dev: setup checks
# installed TrueForge's OpenAPI transport schema and refuses unsafe remote URLs.
# For remote deployments, set a real, authenticated, non-loopback HTTPS MCP URL.
FORGESRE_MCP_URL=
# Bearer token TrueForge sends to the MCP server (generated by scripts/setup.sh)
FORGESRE_MCP_TOKEN=

# TrueForge
TRUEFORGE_URL=http://localhost:8790
TRUEFORGE_PORT=8790
# Optional recurring, read-only on-call investigation. Configure these locally;
# no schedule is created by setup.sh or setup-trueforge.sh. Cadence must be
# standard five-field cron (TrueForge minimum interval: one hour).
TRUEFORGE_SCHEDULE_NAME=
TRUEFORGE_SCHEDULE_AGENT=
TRUEFORGE_SCHEDULE_CRON=
TRUEFORGE_SCHEDULE_TIMEZONE=
TRUEFORGE_SCHEDULE_TASK=
# Optional OIDC ID token for authenticated TrueForge deployments.
TRUEFORGE_TOKEN=

# Model used by the ForgeSRE agent inside TrueForge.
# Recommended: the TrueFoundry AI Gateway (OpenAI-compatible). gpt-4.1-mini is light, fast and
# dependable at tool calling. The key is a TrueFoundry token (a JWT); find the model ids with:
#   curl -H "Authorization: Bearer $MODEL_API_KEY" https://gateway.truefoundry.ai/models
# MODEL_PROVIDER: truefoundry | openai | anthropic | google-gemini | custom | … (TrueForge catalog types)
MODEL_PROVIDER=truefoundry
MODEL_ID=openai-polaris/gpt-4.1-mini
MODEL_API_KEY=
MODEL_BASE_URL=https://gateway.truefoundry.ai
# Only used for reasoning models (gpt-5*, o-series): none | low | medium | high
MODEL_REASONING_EFFORT=low

# Optional second provider, registered in TrueForge so you can switch models in the UI.
OPENAI_API_KEY=
OPENAI_MODEL_IDS=gpt-4.1-mini,gpt-5.4-mini

# Optional: Daytona sandbox. When empty, TrueForge standalone mode uses its
# built-in local sandbox provider (bubblewrap-isolated), which needs bwrap,
# socat and ripgrep on Linux. The Daytona key needs write:sandboxes,
# write:snapshots and delete:snapshots; setup falls back to the local sandbox otherwise.
DAYTONA_API_KEY=

# incident-diagnostics skill (git-backed, cloned into the sandbox).
# auto = attach when the sandbox can clone git repos (Daytona, Debian/Ubuntu hosts);
# otherwise the agent fetches the same analyzer over HTTPS.
FORGESRE_ATTACH_SKILL=auto
FORGESRE_SKILL_REPO=https://github.com/kartikeyajay2006/Agent_that_act-Hackathon
FORGESRE_SKILL_REF=main
